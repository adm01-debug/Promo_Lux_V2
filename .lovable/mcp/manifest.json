{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pesfxhlbsjfmlysdkzhr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lux-ia-mcp",
      "version": "1.0.0",
      "title": "LUX IA"
    },
    "tools": [
      {
        "name": "list_companies",
        "title": "Listar empresas",
        "description": "Lista empresas da base de prospecção do usuário, com busca opcional por nome, setor ou cidade.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 120,
              "description": "Texto para buscar no nome da empresa."
            },
            "sector": {
              "type": "string",
              "maxLength": 80,
              "description": "Filtra por setor exato."
            },
            "min_ipc_score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Score IPC mínimo (0-100)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Quantidade máxima de empresas retornadas (1-50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_company",
        "title": "Detalhar empresa",
        "description": "Retorna os dados completos de uma empresa específica pelo seu identificador.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "Identificador (UUID) da empresa."
            }
          },
          "required": [
            "company_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_decision_makers",
        "title": "Listar decisores",
        "description": "Lista contatos decisores enriquecidos (nome, cargo, empresa, LinkedIn) da base do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_name": {
              "type": "string",
              "maxLength": 120,
              "description": "Filtra decisores pelo nome da empresa."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Quantidade máxima de contatos retornados (1-50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_scrape_jobs",
        "title": "Listar jobs de raspagem",
        "description": "Lista os jobs de raspagem de leads mais recentes com status, origem e quantidade de resultados.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "working",
                "completed",
                "failed",
                "cancelled"
              ],
              "description": "Filtra os jobs por status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15,
              "description": "Quantidade máxima de jobs retornados (1-50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_dashboard_stats",
        "title": "Estatísticas do dashboard",
        "description": "Retorna as métricas consolidadas do dashboard (empresas, enriquecimento, jobs e pipeline) da organização ativa.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "organization_id": {
              "type": "string",
              "format": "uuid",
              "description": "Organização a consultar. Quando omitido, usa a organização padrão do usuário."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
